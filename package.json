{
  "name": "dullsopper",
  "version": "1.0.0",
  "description": "Firefox extension that detects web shops and turns them grayscale to curb impulse spending.",
  "scripts": {
    "test": "node --test test/*.js",
    "lint": "npx web-ext lint",
